# keelson-processor-route-planner deployment settings — copy to .env and fill in.
#   cp .env.example .env
# docker-compose reads these. .env is gitignored (never commit it).

# ---------------------------------------------------------------------------
# chart-server HTTP base, used by chart_adapter for targeted checks
# (grounding-line / depth / identify / catalog). Default points at a local
# chart-server. See docs/CHART-ADAPTER.md.
# ---------------------------------------------------------------------------
CHART_SERVER_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# PostGIS connection for chart_adapter direct bulk reads (P2+). Read-only
# `charts` role; never writes public.*. Unset in the P1 skeleton.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://charts:charts@localhost:5432/charts
